<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingHorizontal="28dp">

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1.2" />

    <ImageView
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@drawable/lock_avatar_bg"
        android:padding="24dp"
        android:contentDescription="TrueDataSUP logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="28dp"
        android:text="Welcome to TrueDataSUP"
        android:textColor="@color/text_dark"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Pay bills in seconds, recharge airtime instantly, and buy data without stress."
        android:textColor="#888888"
        android:textSize="15sp"
        android:lineSpacingExtra="3dp" />

    <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1.6" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/registerButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Register"
            android:textAllCaps="false"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:background="@drawable/welcome_register_bg" />

        <Button
            android:id="@+id/loginButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/welcome_login_bg" />

    </LinearLayout>

    <View android:layout_width="0dp" android:layout_height="40dp" />

</LinearLayout>
